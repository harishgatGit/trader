# =============================================
# AI Stock Analyst Agent
# Environment Configuration
# =============================================

# Application
APP_ENV=local
PORT=3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://trader:trader_pass@localhost:5432/trader_db

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Tokens-per-minute budget for the OpenAI org's gpt-4o tier; used by the
# in-process rate limiter to proactively pace requests. Must match your
# account's actual TPM limit (check the OpenAI dashboard) — raise it if you
# upgrade tiers.
OPENAI_TPM_LIMIT=30000
# Cheaper/secondary model + its own TPM budget for the Phase 4 "supporting" agents
# (Daily Trend, Trend Story, Signal Correlation, Ecosystem Insights) — separate quota
# pool from OPENAI_MODEL/OPENAI_TPM_LIMIT so they don't contend with the flagship report.
OPENAI_SECONDARY_MODEL=gpt-4o-mini
OPENAI_SECONDARY_TPM_LIMIT=200000

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Alpaca Configuration
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Email Alerts (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password
EMAIL_FROM=AI Trader <your@email.com>

# Safety Settings
MAX_POSITION_SIZE_PERCENT=5
MAX_LOSS_PER_TRADE_PERCENT=2
MIN_RISK_REWARD=1.5

# JWT (for future auth)
JWT_SECRET=change_this_to_a_random_secret_string

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-application-id
VITE_MICROSOFT_CLIENT_ID=your-microsoft-application-id

# =============================================
# Video Generation Service
# =============================================
DISABLE_VIDEO_PIPELINE=false

# URL to the Python video generation microservice
VIDEO_SERVICE_URL=http://localhost:8090

# Shared API key between NestJS and Python video service
VIDEO_SERVICE_API_KEY=change-this-to-a-random-secret

# API key Python service uses when sending callbacks back to NestJS
CURRENT_APP_CALLBACK_API_KEY=change-this-to-another-random-secret

# Path to the Remotion project template (relative to video_agents_service)
REMOTION_PROJECT_PATH=./templates/remotion

# =============================================
# YouTube Upload
# =============================================
# OAuth client for the channel videos are published to. Authorize once at
# http://localhost:8090/youtube/login — the refresh token is stored by the service.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Visibility applied to every automated upload: public | unlisted | private
YOUTUBE_UPLOAD_VISIBILITY=public

# TTS Provider: 'edge' (free, no key needed), 'openai', or 'elevenlabs'
TTS_PROVIDER=edge

# Edge-TTS voice name
TTS_VOICE=en-US-ChristopherNeural

# Optional TTS API key for openai or elevenlabs
TTS_API_KEY=

# =============================================
# Social Trending Discovery (YouTube + Reddit)
# =============================================
# Google Cloud Console -> YouTube Data API v3 key (search.list). Free tier:
# 10,000 units/day; one discovery run costs ~400 units (4 queries x 100).
# NOT the same credential as YOUTUBE_SERVICE_API_KEY (that's the internal
# shared secret between NestJS and the Python upload service).
YOUTUBE_DATA_API_KEY=

# Reddit's public old.reddit.com/*.json endpoints need no key — only a
# descriptive User-Agent header (set in code) — so there is no REDDIT_* var.

# =============================================
# Trading Agents Service (trading_agents_service/, port 3100)
# Standalone sector-swarm screening/backtest/paper-execution service. Shares
# the same Postgres database as backend/ (DATABASE_URL above) but reads/writes
# market data on its own, separate from backend's ALPACA_API_KEY.
# =============================================
TRADING_AGENTS_PORT=3100

# Alpaca SIP (consolidated, full-market) feed keys — deliberately separate
# from ALPACA_API_KEY/ALPACA_SECRET_KEY above, which default to the free IEX
# feed. Anything that gates a real (paper) trade decision should use the full
# consolidated tape, not a single-exchange view.
ALPACA_API_KEY_SIP=
ALPACA_SECRET_KEY_SIP=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# SEC EDGAR (data.sec.gov) — authoritative fundamentals source for the sector
# screening agents, replacing Yahoo Finance's unofficial scraped endpoint for
# anything that feeds a trade decision. EDGAR's fair-access policy requires an
# identifying User-Agent on every request.
SEC_EDGAR_USER_AGENT="InvestingAtti trading-agents-service contact:investingatti@gmail.com"

